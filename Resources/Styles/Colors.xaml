<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Tokens CalendAgro (thème clair, cf. AGENTS.md §8). Aucune autre couleur dans les pages. -->
    <Color x:Key="Bg">#FAF8F1</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Text">#1B2A1F</Color>
    <Color x:Key="TextMuted">#5B6B60</Color>
    <Color x:Key="Border">#D9D5C7</Color>
    <Color x:Key="Primary">#2F6B3A</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="Accent">#D98E04</Color>
    <Color x:Key="OnAccent">#1B2A1F</Color>
    <Color x:Key="Error">#C0392B</Color>
    <Color x:Key="Success">#2E7D32</Color>
    <Color x:Key="Semis">#2F6B3A</Color>
    <Color x:Key="Entretien">#1E6FB5</Color>
    <Color x:Key="Recolte">#D98E04</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
</ResourceDictionary>
