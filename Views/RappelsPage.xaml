<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CalendAgro.Views.RappelsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CalendAgro.Controls"
    xmlns:strings="clr-namespace:CalendAgro.Resources.Strings"
    xmlns:vm="clr-namespace:CalendAgro.ViewModels"
    x:DataType="vm:RappelsViewModel"
    Title="{x:Static strings:AppResources.Rappels_Titre}">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader
            Grid.Row="0"
            BackCommand="{Binding RetourCommand}"
            Title="{x:Static strings:AppResources.Rappels_Entete}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="16,16,16,16"
                Spacing="16">

            <controls:StateView
                IsVisible="{Binding IsBusy}"
                Message="{x:Static strings:AppResources.Rappels_Chargement}"
                State="Loading" />

            <controls:StateView
                ActionCommand="{Binding RechargerCommand}"
                ActionText="{x:Static strings:AppResources.Composants_Reessayer}"
                IsVisible="{Binding HasError}"
                Message="{x:Static strings:AppResources.Rappels_Erreur}"
                State="Error" />

            <VerticalStackLayout
                Spacing="16"
                IsVisible="{Binding IsContenuVisible}">

                <controls:StateView
                    ActionCommand="{Binding AjouterParcelleCommand}"
                    ActionText="{x:Static strings:AppResources.Parcelles_Ajouter}"
                    IsVisible="{Binding ListeVide}"
                    Message="{x:Static strings:AppResources.Rappels_AucunAide}"
                    State="Empty" />

                <VerticalStackLayout
                    Spacing="12"
                    BindableLayout.ItemsSource="{Binding Items}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:RappelCarte">
                            <Border Style="{StaticResource Card}">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <controls:StepBadge
                                                HorizontalOptions="Start"
                                                Kind="{Binding Kind}"
                                                Text="{Binding Phase}" />
                                            <Label
                                                Style="{StaticResource Title2}"
                                                Text="{Binding Titre}" />
                                            <Label
                                                Style="{StaticResource BodySmall}"
                                                Text="{Binding Parcelle}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalOptions="Center">
                                            <Switch
                                                HorizontalOptions="Center"
                                                IsToggled="{Binding Actif, Mode=TwoWay}"
                                                SemanticProperties.Description="{Binding DescriptionBascule}" />
                                            <Label
                                                HorizontalTextAlignment="Center"
                                                Style="{StaticResource BodySmall}"
                                                Text="{Binding EtatLibelle}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Image
                                            Grid.Column="0"
                                            HeightRequest="18"
                                            Source="calendar_days.svg"
                                            VerticalOptions="Center"
                                            WidthRequest="18" />
                                        <Label
                                            Grid.Column="1"
                                            Style="{StaticResource BodySmall}"
                                            Text="{Binding Date}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label
                    Style="{StaticResource ErrorText}"
                    IsVisible="{Binding ErreurBasculeVisible}"
                    Text="{Binding ErreurBascule}" />

                <Label
                    Style="{StaticResource BodySmall}"
                    Text="{x:Static strings:AppResources.Rappels_Note}" />

            </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
