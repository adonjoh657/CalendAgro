<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CalendAgro.Views.FicheCulturePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CalendAgro.Controls"
    xmlns:strings="clr-namespace:CalendAgro.Resources.Strings"
    xmlns:vm="clr-namespace:CalendAgro.ViewModels"
    x:DataType="vm:FicheCultureViewModel"
    Title="{Binding Nom}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="24">

            <Button
                Command="{Binding RetourCommand}"
                ContentLayout="Left,8"
                HorizontalOptions="Start"
                ImageSource="arrow_left.svg"
                Style="{StaticResource TextButton}"
                Text="{x:Static strings:AppResources.Fiche_Retour}" />

            <controls:StateView
                IsVisible="{Binding IsBusy}"
                Message="{x:Static strings:AppResources.Fiche_Chargement}"
                State="Loading" />

            <controls:StateView
                ActionCommand="{Binding RechargerCommand}"
                ActionText="{x:Static strings:AppResources.Composants_Reessayer}"
                IsVisible="{Binding HasError}"
                Message="{x:Static strings:AppResources.Connexion_Erreur}"
                State="Error" />

            <controls:StateView
                ActionCommand="{Binding RetourCatalogueCommand}"
                ActionText="{x:Static strings:AppResources.Fiche_RetourCatalogue}"
                IsVisible="{Binding Introuvable}"
                Message="{x:Static strings:AppResources.Fiche_Introuvable}"
                State="Empty" />

            <VerticalStackLayout
                Spacing="24"
                IsVisible="{Binding IsContenuVisible}">

                <VerticalStackLayout Spacing="4">
                    <Label
                        Style="{StaticResource Title1}"
                        Text="{Binding Nom}" />
                    <Label
                        Style="{StaticResource BodySmall}"
                        Text="{Binding Cycle}" />
                    <Label
                        Style="{StaticResource BodySmall}"
                        Text="{Binding Region}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label
                        Style="{StaticResource Title2}"
                        Text="{x:Static strings:AppResources.Fiche_Calendrier}" />
                    <Grid
                        ColumnDefinitions="Auto,*,Auto,*"
                        ColumnSpacing="8">
                        <Label
                            Grid.Column="0"
                            Style="{StaticResource Legend}"
                            Text="{x:Static strings:AppResources.Fiche_Zone}"
                            VerticalOptions="Center" />
                        <Picker
                            Grid.Column="1"
                            ItemsSource="{Binding Zones}"
                            SelectedItem="{Binding ZoneChoisie}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="2"
                            Style="{StaticResource Legend}"
                            Text="{x:Static strings:AppResources.Fiche_Saison}"
                            VerticalOptions="Center" />
                        <Picker
                            Grid.Column="3"
                            ItemsSource="{Binding Saisons}"
                            SelectedItem="{Binding SaisonChoisie}"
                            VerticalOptions="Center" />
                    </Grid>
                    <HorizontalStackLayout Spacing="12">
                        <controls:StepBadge
                            Kind="Semis"
                            Text="{x:Static strings:AppResources.Charte_BadgeSemis}" />
                        <controls:StepBadge
                            Kind="Entretien"
                            Text="{x:Static strings:AppResources.Charte_BadgeEntretien}" />
                        <controls:StepBadge
                            Kind="Recolte"
                            Text="{x:Static strings:AppResources.Charte_BadgeRecolte}" />
                    </HorizontalStackLayout>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8"
                                Padding="0,0,0,8">
                                <Label
                                    Grid.Column="0"
                                    Style="{StaticResource Legend}"
                                    Text="{x:Static strings:AppResources.Fiche_Mois}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource Legend}"
                                    Text="{x:Static strings:AppResources.Fiche_Phase}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <VerticalStackLayout
                                Spacing="8"
                                BindableLayout.ItemsSource="{Binding Mois}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MoisLigne">
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource Legend}"
                                                    Text="{Binding Nom}"
                                                    VerticalOptions="Center" />
                                                <controls:StepBadge
                                                    Grid.Column="1"
                                                    IsVisible="{Binding AvecPhase}"
                                                    Kind="{Binding Kind}"
                                                    Text="{Binding PhaseLabel}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="1"
                                                    Style="{StaticResource BodySmall}"
                                                    Text="{x:Static strings:AppResources.Fiche_HorsCycle}"
                                                    IsVisible="{Binding SansPhase}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                            <BoxView
                                                HeightRequest="1"
                                                Color="{StaticResource Border}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Label
                        Style="{StaticResource BodySmall}"
                        Text="{x:Static strings:AppResources.Fiche_NoteCalendrier}" />
                </VerticalStackLayout>

                <Label
                    Style="{StaticResource Title2}"
                    Text="{x:Static strings:AppResources.Fiche_Conseils}" />

                <VerticalStackLayout
                    Spacing="16"
                    BindableLayout.ItemsSource="{Binding Phases}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhaseConseils">
                            <VerticalStackLayout Spacing="8">
                                <controls:StepBadge
                                    Kind="{Binding Kind}"
                                    Text="{Binding Titre}" />
                                <VerticalStackLayout
                                    Spacing="8"
                                    BindableLayout.ItemsSource="{Binding Textes}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <HorizontalStackLayout Spacing="8">
                                                <Image
                                                    HeightRequest="20"
                                                    Source="check.svg"
                                                    VerticalOptions="Start"
                                                    WidthRequest="20" />
                                                <Label
                                                    Style="{StaticResource Body}"
                                                    Text="{Binding .}"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label
                    Style="{StaticResource BodySmall}"
                    Text="{x:Static strings:AppResources.Fiche_NoteConseils}" />

                <Label
                    Style="{StaticResource ErrorText}"
                    IsVisible="{Binding NavigationErreurVisible}"
                    Text="{Binding NavigationErreur}" />

                <controls:AppButton
                    Command="{Binding AjouterParcelleCommand}"
                    Text="{x:Static strings:AppResources.Fiche_AjouterParcelle}"
                    Variant="Accent" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
