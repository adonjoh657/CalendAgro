<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CalendAgro.Views.FicheCulturePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CalendAgro.Controls"
    xmlns:strings="clr-namespace:CalendAgro.Resources.Strings"
    xmlns:vm="clr-namespace:CalendAgro.ViewModels"
    x:DataType="vm:FicheCultureViewModel"
    Title="{Binding Nom}">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader
            Grid.Row="0"
            BackCommand="{Binding RetourCommand}"
            Title="{Binding Nom}">
            <controls:PageHeader.Actions>
                <ImageButton
                    BackgroundColor="Transparent"
                    Command="{Binding OuvrirOptionsCommand}"
                    HeightRequest="48"
                    Padding="12"
                    SemanticProperties.Description="{x:Static strings:AppResources.Fiche_Options}"
                    Source="menu.svg"
                    WidthRequest="48" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="24,16,24,88"
                Spacing="24">

            <controls:StateView
                IsVisible="{Binding IsBusy}"
                Message="{x:Static strings:AppResources.Fiche_Chargement}"
                State="Loading" />

            <controls:StateView
                ActionCommand="{Binding RechargerCommand}"
                ActionText="{x:Static strings:AppResources.Composants_Reessayer}"
                IsVisible="{Binding HasError}"
                Message="{x:Static strings:AppResources.Connexion_Erreur}"
                State="Error" />

            <controls:StateView
                ActionCommand="{Binding RetourCatalogueCommand}"
                ActionText="{x:Static strings:AppResources.Fiche_RetourCatalogue}"
                IsVisible="{Binding Introuvable}"
                Message="{x:Static strings:AppResources.Fiche_Introuvable}"
                State="Empty" />

            <VerticalStackLayout
                Spacing="24"
                IsVisible="{Binding IsContenuVisible}">

                <Label
                    Style="{StaticResource BodySmall}"
                    Text="{Binding Region}" />

                <VerticalStackLayout Spacing="12">
                    <Label
                        Style="{StaticResource Title2}"
                        Text="{x:Static strings:AppResources.Fiche_Calendrier}" />
                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="8"
                        RowDefinitions="Auto,Auto"
                        RowSpacing="8">
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource Legend}"
                            Text="{x:Static strings:AppResources.Fiche_Zone}"
                            VerticalOptions="Center" />
                        <Picker
                            Grid.Row="0"
                            Grid.Column="1"
                            HorizontalOptions="Fill"
                            ItemsSource="{Binding Zones}"
                            SelectedItem="{Binding ZoneChoisie}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource Legend}"
                            Text="{x:Static strings:AppResources.Fiche_Saison}"
                            VerticalOptions="Center" />
                        <Picker
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalOptions="Fill"
                            ItemsSource="{Binding Saisons}"
                            SelectedItem="{Binding SaisonChoisie}"
                            VerticalOptions="Center" />
                    </Grid>
                    <HorizontalStackLayout Spacing="12">
                        <controls:StepBadge
                            Kind="Semis"
                            Text="{x:Static strings:AppResources.Charte_BadgeSemis}" />
                        <controls:StepBadge
                            Kind="Entretien"
                            Text="{x:Static strings:AppResources.Charte_BadgeEntretien}" />
                        <controls:StepBadge
                            Kind="Recolte"
                            Text="{x:Static strings:AppResources.Charte_BadgeRecolte}" />
                    </HorizontalStackLayout>
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="0">
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8"
                                Padding="0,0,0,8">
                                <Label
                                    Grid.Column="0"
                                    Style="{StaticResource Legend}"
                                    Text="{x:Static strings:AppResources.Fiche_Mois}"
                                    VerticalOptions="Center" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource Legend}"
                                    Text="{x:Static strings:AppResources.Fiche_Phase}"
                                    VerticalOptions="Center" />
                            </Grid>
                            <VerticalStackLayout
                                Spacing="8"
                                BindableLayout.ItemsSource="{Binding Mois}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MoisLigne">
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource Legend}"
                                                    Text="{Binding Nom}"
                                                    VerticalOptions="Center" />
                                                <controls:StepBadge
                                                    Grid.Column="1"
                                                    IsVisible="{Binding AvecPhase}"
                                                    Kind="{Binding Kind}"
                                                    Text="{Binding PhaseLabel}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    Grid.Column="1"
                                                    Style="{StaticResource BodySmall}"
                                                    Text="{x:Static strings:AppResources.Fiche_HorsCycle}"
                                                    IsVisible="{Binding SansPhase}"
                                                    VerticalOptions="Center" />
                                            </Grid>
                                            <BoxView
                                                HeightRequest="1"
                                                Color="{StaticResource Border}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Label
                        Style="{StaticResource BodySmall}"
                        Text="{x:Static strings:AppResources.Fiche_NoteCalendrier}" />
                </VerticalStackLayout>

                <Label
                    Style="{StaticResource ErrorText}"
                    IsVisible="{Binding NavigationErreurVisible}"
                    Text="{Binding NavigationErreur}" />

            </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Button
            Grid.Row="1"
            Margin="0,0,16,16"
            BackgroundColor="{StaticResource Primary}"
            Command="{Binding AjouterParcelleCommand}"
            CornerRadius="28"
            HeightRequest="56"
            HorizontalOptions="End"
            ImageSource="plus.svg"
            SemanticProperties.Description="{x:Static strings:AppResources.Fiche_AjouterParcelle}"
            VerticalOptions="End"
            WidthRequest="56" />
    </Grid>

</ContentPage>
