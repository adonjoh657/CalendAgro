<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CalendAgro.Views.AccueilPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CalendAgro.Controls"
    xmlns:strings="clr-namespace:CalendAgro.Resources.Strings"
    xmlns:views="clr-namespace:CalendAgro.Views"
    xmlns:vm="clr-namespace:CalendAgro.ViewModels"
    x:DataType="vm:AccueilViewModel"
    Title="{x:Static strings:AppResources.Accueil_Titre}">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader
            Grid.Row="0"
            ShowBack="False"
            Title="{x:Static strings:AppResources.App_Nom}">
            <controls:PageHeader.Actions>
                <HorizontalStackLayout Spacing="12">
                    <Grid
                        HeightRequest="48"
                        SemanticProperties.Description="{x:Static strings:AppResources.Rappels_Titre}"
                        WidthRequest="48">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OuvrirRappelsCommand}" />
                        </Grid.GestureRecognizers>
                        <Image
                            HeightRequest="24"
                            HorizontalOptions="Center"
                            Source="bell.svg"
                            VerticalOptions="Center"
                            WidthRequest="24" />
                    </Grid>
                    <Border
                        BackgroundColor="{StaticResource Surface}"
                        HeightRequest="48"
                        SemanticProperties.Description="{x:Static strings:AppResources.Profil_Titre}"
                        Stroke="{StaticResource Border}"
                        StrokeShape="RoundRectangle 999"
                        StrokeThickness="1"
                        WidthRequest="48">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OuvrirProfilCommand}" />
                        </Border.GestureRecognizers>
                        <Image
                            HeightRequest="24"
                            HorizontalOptions="Center"
                            Source="user.svg"
                            VerticalOptions="Center"
                            WidthRequest="24" />
                    </Border>
                </HorizontalStackLayout>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="16,16,16,16"
                Spacing="16">

            <controls:StateView
                IsVisible="{Binding IsBusy}"
                Message="{x:Static strings:AppResources.Accueil_Chargement}"
                State="Loading" />

            <controls:StateView
                ActionCommand="{Binding RechargerCommand}"
                ActionText="{x:Static strings:AppResources.Composants_Reessayer}"
                IsVisible="{Binding HasError}"
                Message="{x:Static strings:AppResources.Connexion_Erreur}"
                State="Error" />

            <VerticalStackLayout
                Spacing="16"
                IsVisible="{Binding IsContenuVisible}">

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">
                    <Border
                        Grid.Column="0"
                        BackgroundColor="{StaticResource Primary}"
                        Padding="16"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontFamily="Inter"
                                FontSize="24"
                                Text="{Binding NbTravaux}"
                                TextColor="{StaticResource OnPrimary}" />
                            <Label
                                FontFamily="Inter"
                                FontSize="14"
                                Text="{x:Static strings:AppResources.Accueil_ATraiter}"
                                TextColor="{StaticResource OnPrimary}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="1"
                        BackgroundColor="{StaticResource Primary}"
                        Padding="16"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">
                        <VerticalStackLayout Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontFamily="Inter"
                                FontSize="24"
                                Text="{Binding NbParcelles}"
                                TextColor="{StaticResource OnPrimary}" />
                            <Label
                                FontFamily="Inter"
                                FontSize="14"
                                Text="{x:Static strings:AppResources.Accueil_DansCarnet}"
                                TextColor="{StaticResource OnPrimary}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        Style="{StaticResource Title2}"
                        Text="{x:Static strings:AppResources.Accueil_TravauxAVenir}"
                        VerticalOptions="Center" />
                    <Grid
                        Grid.Column="1"
                        HeightRequest="48"
                        WidthRequest="48">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OuvrirCalendrierCommand}" />
                        </Grid.GestureRecognizers>
                        <Image
                            HeightRequest="24"
                            HorizontalOptions="Center"
                            Source="calendar_days.svg"
                            VerticalOptions="Center"
                            WidthRequest="24" />
                    </Grid>
                </Grid>

                <VerticalStackLayout
                    Spacing="12"
                    BindableLayout.ItemsSource="{Binding Travaux}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TravailCarte">
                            <Border Style="{StaticResource Card}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type views:AccueilPage}}, Path=BindingContext.OuvrirDetailCommand}"
                                        CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <controls:StepBadge
                                            Grid.Column="0"
                                            Kind="{Binding Kind}"
                                            Text="{Binding Phase}"
                                            VerticalOptions="Center" />
                                        <Label
                                            Grid.Column="1"
                                            Style="{StaticResource BodySmall}"
                                            Text="{Binding Jour}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                    <Label
                                        Style="{StaticResource Title2}"
                                        Text="{Binding Titre}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Image
                                            Grid.Column="0"
                                            HeightRequest="18"
                                            Source="sprout.svg"
                                            VerticalOptions="Center"
                                            WidthRequest="18" />
                                        <Label
                                            Grid.Column="1"
                                            Style="{StaticResource BodySmall}"
                                            Text="{Binding Parcelle}"
                                            VerticalOptions="Center" />
                                        <Image
                                            Grid.Column="2"
                                            HeightRequest="18"
                                            Source="chevron_right.svg"
                                            VerticalOptions="Center"
                                            WidthRequest="18" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                    <BindableLayout.EmptyView>
                        <Label
                            Style="{StaticResource Body}"
                            Text="{x:Static strings:AppResources.Accueil_AucunTravail}" />
                    </BindableLayout.EmptyView>
                </VerticalStackLayout>

                <Label
                    Style="{StaticResource BodySmall}"
                    Text="{Binding VenirAussi}" />

                <VerticalStackLayout Spacing="8">
                    <Label
                        Style="{StaticResource Title2}"
                        Text="{x:Static strings:AppResources.Accueil_VosParcelles}" />
                    <Border Style="{StaticResource Card}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OuvrirParcellesCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image
                                Grid.Column="0"
                                HeightRequest="24"
                                Source="sprout.svg"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label
                                    Style="{StaticResource Legend}"
                                    Text="{Binding CulturesResume}" />
                                <Label
                                    Style="{StaticResource BodySmall}"
                                    Text="{Binding SurfaceTotale}" />
                            </VerticalStackLayout>
                            <Image
                                Grid.Column="2"
                                HeightRequest="20"
                                Source="chevron_right.svg"
                                VerticalOptions="Center"
                                WidthRequest="20" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Label
                    Style="{StaticResource BodySmall}"
                    Text="{x:Static strings:AppResources.Accueil_NoteIndicative}" />

                <Label
                    Style="{StaticResource ErrorText}"
                    IsVisible="{Binding NavigationErreurVisible}"
                    Text="{Binding NavigationErreur}" />

            </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
