<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CalendAgro.Views.InscriptionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CalendAgro.Controls"
    xmlns:strings="clr-namespace:CalendAgro.Resources.Strings"
    xmlns:vm="clr-namespace:CalendAgro.ViewModels"
    x:DataType="vm:InscriptionViewModel"
    Title="{x:Static strings:AppResources.Inscription_Titre}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="24">

            <VerticalStackLayout Spacing="8">
                <Button
                    Command="{Binding RetourCommand}"
                    ContentLayout="Left,8"
                    HorizontalOptions="Start"
                    ImageSource="arrow_left.svg"
                    Style="{StaticResource TextButton}"
                    Text="{x:Static strings:AppResources.Inscription_Retour}" />
                <Label
                    Style="{StaticResource BodySmall}"
                    Text="{x:Static strings:AppResources.Inscription_SousTitre}" />
            </VerticalStackLayout>

            <controls:StateView
                IsVisible="{Binding IsBusy}"
                Message="{x:Static strings:AppResources.Inscription_Chargement}"
                State="Loading" />

            <controls:StateView
                ActionCommand="{Binding CreerCompteCommand}"
                ActionText="{x:Static strings:AppResources.Composants_Reessayer}"
                IsVisible="{Binding HasError}"
                Message="{x:Static strings:AppResources.Connexion_Erreur}"
                State="Error" />

            <VerticalStackLayout
                Spacing="16"
                IsVisible="{Binding IsFormVisible}">

                <controls:ValidatedField
                    Erreur="{Binding NomErreur}"
                    Label="{x:Static strings:AppResources.Inscription_Nom}"
                    Placeholder="{x:Static strings:AppResources.Inscription_NomExemple}"
                    Succes="{Binding NomSucces}"
                    Text="{Binding Nom}" />

                <controls:ValidatedField
                    Erreur="{Binding IdentifiantErreur}"
                    Keyboard="Telephone"
                    Label="{x:Static strings:AppResources.Connexion_Identifiant}"
                    Placeholder="{x:Static strings:AppResources.Inscription_TelephoneExemple}"
                    Text="{Binding Identifiant}" />

                <controls:ValidatedField
                    Erreur="{Binding MotDePasseErreur}"
                    IsPasswordField="True"
                    Label="{x:Static strings:AppResources.Connexion_MotDePasse}"
                    Succes="{Binding MotDePasseSucces}"
                    Text="{Binding MotDePasse}" />

                <controls:ValidatedField
                    Aide="{x:Static strings:AppResources.Inscription_ConfirmationAide}"
                    Erreur="{Binding ConfirmationErreur}"
                    IsPasswordField="True"
                    Label="{x:Static strings:AppResources.Inscription_Confirmation}"
                    Placeholder="{x:Static strings:AppResources.Inscription_ConfirmationExemple}"
                    Text="{Binding Confirmation}" />

                <controls:ValidatedField
                    Erreur="{Binding TelephoneErreur}"
                    Keyboard="Telephone"
                    Label="{x:Static strings:AppResources.Inscription_Telephone}"
                    Placeholder="{x:Static strings:AppResources.Inscription_TelExemple}"
                    Text="{Binding Telephone}" />

                <VerticalStackLayout Spacing="4">
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding Consentement}" VerticalOptions="Center" />
                        <Label
                            Style="{StaticResource Body}"
                            Text="{x:Static strings:AppResources.Inscription_Consentement}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label
                        Style="{StaticResource ErrorText}"
                        Text="{Binding ConsentementErreur}" />
                </VerticalStackLayout>

                <Label
                    Style="{StaticResource ErrorText}"
                    Text="{Binding FormErreur}" />

                <controls:AppButton
                    Command="{Binding CreerCompteCommand}"
                    Text="{x:Static strings:AppResources.Inscription_Creer}"
                    Variant="Accent" />

                <Label
                    Style="{StaticResource BodySmall}"
                    IsVisible="{Binding ResumeVisible}"
                    Text="{x:Static strings:AppResources.Inscription_Resume}" />

                <Button
                    Command="{Binding AllerConnexionCommand}"
                    HorizontalOptions="Center"
                    Style="{StaticResource TextButton}"
                    Text="{x:Static strings:AppResources.Inscription_LienConnexion}" />

            </VerticalStackLayout>

            <Label
                Style="{StaticResource BodySmall}"
                Text="{x:Static strings:AppResources.Connexion_Pied}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
