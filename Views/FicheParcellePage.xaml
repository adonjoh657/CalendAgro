<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CalendAgro.Views.FicheParcellePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CalendAgro.Controls"
    xmlns:strings="clr-namespace:CalendAgro.Resources.Strings"
    xmlns:vm="clr-namespace:CalendAgro.ViewModels"
    x:DataType="vm:FicheParcelleViewModel"
    Title="{Binding Nom}">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="24">

            <Button
                Command="{Binding RetourCommand}"
                ContentLayout="Left,8"
                HorizontalOptions="Start"
                ImageSource="arrow_left.svg"
                Style="{StaticResource TextButton}"
                Text="{x:Static strings:AppResources.Parcelle_Retour}" />

            <controls:StateView
                IsVisible="{Binding IsBusy}"
                Message="{x:Static strings:AppResources.FicheParcelle_Chargement}"
                State="Loading" />

            <controls:StateView
                ActionCommand="{Binding RechargerCommand}"
                ActionText="{x:Static strings:AppResources.Composants_Reessayer}"
                IsVisible="{Binding HasError}"
                Message="{x:Static strings:AppResources.Connexion_Erreur}"
                State="Error" />

            <controls:StateView
                ActionCommand="{Binding RetourCommand}"
                ActionText="{x:Static strings:AppResources.Parcelle_Retour}"
                IsVisible="{Binding Introuvable}"
                Message="{x:Static strings:AppResources.FicheParcelle_Introuvable}"
                State="Empty" />

            <VerticalStackLayout
                Spacing="24"
                IsVisible="{Binding IsContenuVisible}">

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Style="{StaticResource Legend}"
                            Text="{x:Static strings:AppResources.FicheParcelle_Culture}" />
                        <Label
                            Style="{StaticResource Title2}"
                            Text="{Binding CultureNom}" />
                        <Label
                            Style="{StaticResource Body}"
                            Text="{Binding Infos}" />
                        <Label
                            Style="{StaticResource BodySmall}"
                            Text="{Binding DateSemis}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label
                        Style="{StaticResource Title2}"
                        Text="{x:Static strings:AppResources.FicheParcelle_Prochain}" />
                    <Border
                        Style="{StaticResource Card}"
                        IsVisible="{Binding AvecTravail}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OuvrirTravailCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8">
                            <controls:StepBadge
                                Kind="{Binding Kind}"
                                Text="{Binding Phase}"
                                VerticalOptions="Center" />
                            <Label
                                Style="{StaticResource Body}"
                                Text="{Binding Prochain}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Label
                        Style="{StaticResource Body}"
                        IsVisible="{Binding SansTravail}"
                        Text="{x:Static strings:AppResources.FicheParcelle_SansTravail}" />
                </VerticalStackLayout>

                <Label
                    Style="{StaticResource ErrorText}"
                    IsVisible="{Binding NavigationErreurVisible}"
                    Text="{Binding NavigationErreur}" />

                <Button
                    Command="{Binding SupprimerCommand}"
                    HorizontalOptions="Center"
                    Style="{StaticResource TextButton}"
                    Text="{x:Static strings:AppResources.FicheParcelle_Supprimer}"
                    TextColor="{StaticResource Error}" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
