<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CalendAgro.Views.ChartePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:CalendAgro.Resources.Strings"
    x:DataType="ContentPage"
    Title="{x:Static strings:AppResources.Charte_Titre}">

    <ScrollView>
        <VerticalStackLayout
            Padding="16"
            Spacing="16">

            <Label
                Style="{StaticResource BodySmall}"
                Text="{x:Static strings:AppResources.Charte_SousTitre}" />

            <!-- Couleurs -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Style="{StaticResource Title2}"
                        Text="{x:Static strings:AppResources.Charte_SectionCouleurs}" />
                    <Grid
                        ColumnDefinitions="48,*,*"
                        ColumnSpacing="12"
                        RowDefinitions="48,48,48,48,48,48,48"
                        RowSpacing="12">
                        <Border Grid.Row="0" Grid.Column="0" BackgroundColor="{StaticResource Bg}" Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 8" />
                        <Label Grid.Row="0" Grid.Column="1" Style="{StaticResource Legend}" Text="Bg" VerticalOptions="Center" />
                        <Label Grid.Row="0" Grid.Column="2" Style="{StaticResource BodySmall}" Text="#FAF8F1" VerticalOptions="Center" />

                        <Border Grid.Row="1" Grid.Column="0" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource Border}" StrokeShape="RoundRectangle 8" />
                        <Label Grid.Row="1" Grid.Column="1" Style="{StaticResource Legend}" Text="Surface" VerticalOptions="Center" />
                        <Label Grid.Row="1" Grid.Column="2" Style="{StaticResource BodySmall}" Text="#FFFFFF" VerticalOptions="Center" />

                        <Border Grid.Row="2" Grid.Column="0" BackgroundColor="{StaticResource Text}" StrokeShape="RoundRectangle 8" />
                        <Label Grid.Row="2" Grid.Column="1" Style="{StaticResource Legend}" Text="Text" VerticalOptions="Center" />
                        <Label Grid.Row="2" Grid.Column="2" Style="{StaticResource BodySmall}" Text="#1B2A1F" VerticalOptions="Center" />

                        <Border Grid.Row="3" Grid.Column="0" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 8" />
                        <Label Grid.Row="3" Grid.Column="1" Style="{StaticResource Legend}" Text="Primary" VerticalOptions="Center" />
                        <Label Grid.Row="3" Grid.Column="2" Style="{StaticResource BodySmall}" Text="#2F6B3A" VerticalOptions="Center" />

                        <Border Grid.Row="4" Grid.Column="0" BackgroundColor="{StaticResource Accent}" StrokeShape="RoundRectangle 8" />
                        <Label Grid.Row="4" Grid.Column="1" Style="{StaticResource Legend}" Text="Accent" VerticalOptions="Center" />
                        <Label Grid.Row="4" Grid.Column="2" Style="{StaticResource BodySmall}" Text="#D98E04" VerticalOptions="Center" />

                        <Border Grid.Row="5" Grid.Column="0" BackgroundColor="{StaticResource Error}" StrokeShape="RoundRectangle 8" />
                        <Label Grid.Row="5" Grid.Column="1" Style="{StaticResource Legend}" Text="Error" VerticalOptions="Center" />
                        <Label Grid.Row="5" Grid.Column="2" Style="{StaticResource BodySmall}" Text="#C0392B" VerticalOptions="Center" />

                        <Border Grid.Row="6" Grid.Column="0" BackgroundColor="{StaticResource Success}" StrokeShape="RoundRectangle 8" />
                        <Label Grid.Row="6" Grid.Column="1" Style="{StaticResource Legend}" Text="Success" VerticalOptions="Center" />
                        <Label Grid.Row="6" Grid.Column="2" Style="{StaticResource BodySmall}" Text="#2E7D32" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Typographie -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Style="{StaticResource Title2}"
                        Text="{x:Static strings:AppResources.Charte_SectionTypo}" />
                    <Label
                        Style="{StaticResource Title1}"
                        Text="{x:Static strings:AppResources.Charte_TitreExemple}" />
                    <Label
                        Style="{StaticResource Title2}"
                        Text="{x:Static strings:AppResources.Charte_SousTitreExemple}" />
                    <Label
                        Style="{StaticResource Body}"
                        Text="{x:Static strings:AppResources.Charte_CorpsExemple}" />
                    <Label
                        Style="{StaticResource BodySmall}"
                        Text="{x:Static strings:AppResources.Charte_PetitExemple}" />
                    <Label
                        Style="{StaticResource Legend}"
                        Text="{x:Static strings:AppResources.Charte_LegendeExemple}" />
                </VerticalStackLayout>
            </Border>

            <!-- Phases : icône + libellé, jamais couleur seule -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Style="{StaticResource Title2}"
                        Text="{x:Static strings:AppResources.Charte_SectionPhases}" />
                    <HorizontalStackLayout Spacing="12">
                        <Border BackgroundColor="{StaticResource Semis}" StrokeShape="RoundRectangle 999" Padding="12,8">
                            <Label Text="S" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" VerticalOptions="Center" />
                        </Border>
                        <Label Style="{StaticResource Legend}" Text="{x:Static strings:AppResources.Charte_BadgeSemis}" VerticalOptions="Center" />
                        <Border BackgroundColor="{StaticResource Entretien}" StrokeShape="RoundRectangle 999" Padding="12,8">
                            <Label Text="E" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnPrimary}" VerticalOptions="Center" />
                        </Border>
                        <Label Style="{StaticResource Legend}" Text="{x:Static strings:AppResources.Charte_BadgeEntretien}" VerticalOptions="Center" />
                        <Border BackgroundColor="{StaticResource Recolte}" StrokeShape="RoundRectangle 999" Padding="12,8">
                            <Label Text="R" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource OnAccent}" VerticalOptions="Center" />
                        </Border>
                        <Label Style="{StaticResource Legend}" Text="{x:Static strings:AppResources.Charte_BadgeRecolte}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Boutons 56 -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Style="{StaticResource Title2}"
                        Text="{x:Static strings:AppResources.Charte_SectionBoutons}" />
                    <Button Text="{x:Static strings:AppResources.Charte_BoutonPrimaire}" />
                    <Button Style="{StaticResource AccentButton}" Text="{x:Static strings:AppResources.Charte_BoutonAccent}" />
                    <Button IsEnabled="False" Text="{x:Static strings:AppResources.Charte_BoutonDesactive}" />
                    <Label
                        Style="{StaticResource BodySmall}"
                        Text="{x:Static strings:AppResources.Charte_NoteHorsLigne}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
