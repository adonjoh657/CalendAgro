<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CalendAgro.Views.ComposantsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CalendAgro.Controls"
    xmlns:strings="clr-namespace:CalendAgro.Resources.Strings"
    xmlns:vm="clr-namespace:CalendAgro.ViewModels"
    x:DataType="vm:ComposantsViewModel"
    Title="{x:Static strings:AppResources.Composants_Titre}">

    <ScrollView>
        <VerticalStackLayout
            Padding="16"
            Spacing="16">

            <Label
                Style="{StaticResource BodySmall}"
                Text="{x:Static strings:AppResources.Composants_SousTitre}" />

            <Label
                Style="{StaticResource Title2}"
                Text="{x:Static strings:AppResources.Composants_SectionBoutons}" />
            <controls:AppButton Text="{x:Static strings:AppResources.Charte_BoutonPrimaire}" />
            <controls:AppButton
                Variant="Accent"
                Text="{x:Static strings:AppResources.Charte_BoutonAccent}" />
            <controls:AppButton
                IsEnabled="False"
                Text="{x:Static strings:AppResources.Charte_BoutonDesactive}" />

            <Label
                Style="{StaticResource Title2}"
                Text="{x:Static strings:AppResources.Composants_SectionCartes}" />
            <controls:AppCard Title="{x:Static strings:AppResources.Composants_CarteTitre}">
                <Label
                    Style="{StaticResource Body}"
                    Text="{x:Static strings:AppResources.Composants_CarteCorps}" />
            </controls:AppCard>

            <Label
                Style="{StaticResource Title2}"
                Text="{x:Static strings:AppResources.Composants_SectionChamps}" />
            <controls:ValidatedField
                Aide="{x:Static strings:AppResources.Parcelle_NomAide}"
                Label="{x:Static strings:AppResources.Parcelle_Nom}"
                Succes="{x:Static strings:AppResources.Inscription_NomValide}"
                Text="{x:Static strings:AppResources.Inscription_NomExemple}" />
            <controls:ValidatedField
                Erreur="{x:Static strings:AppResources.Connexion_IdentifiantInvalide}"
                Label="{x:Static strings:AppResources.Connexion_Identifiant}"
                Text="mireille@" />

            <Label
                Style="{StaticResource Title2}"
                Text="{x:Static strings:AppResources.Composants_SectionBadges}" />
            <controls:StepBadge
                Kind="Semis"
                Text="{x:Static strings:AppResources.Charte_BadgeSemis}" />
            <controls:StepBadge
                Kind="Entretien"
                Text="{x:Static strings:AppResources.Charte_BadgeEntretien}" />
            <controls:StepBadge
                Kind="Recolte"
                Text="{x:Static strings:AppResources.Charte_BadgeRecolte}" />

            <Label
                Style="{StaticResource Title2}"
                Text="{x:Static strings:AppResources.Composants_SectionEtats}" />
            <controls:StateView
                ActionCommand="{Binding RetryCommand}"
                ActionText="{x:Static strings:AppResources.Composants_Reessayer}"
                Message="{x:Static strings:AppResources.Composants_EtatVide}"
                State="Empty" />
            <controls:StateView
                Message="{x:Static strings:AppResources.Composants_EtatChargement}"
                State="Loading" />
            <controls:StateView
                ActionCommand="{Binding RetryCommand}"
                ActionText="{x:Static strings:AppResources.Composants_Reessayer}"
                Message="{x:Static strings:AppResources.Composants_EtatErreur}"
                State="Error" />

            <Label
                Style="{StaticResource Title2}"
                Text="{x:Static strings:AppResources.Composants_SectionDirect}" />
            <controls:StateView
                ActionCommand="{Binding RetryCommand}"
                ActionText="{x:Static strings:AppResources.Composants_Reessayer}"
                Message="{Binding LiveMessage}"
                State="{Binding LiveState}" />
            <controls:AppButton
                Command="{Binding CycleLiveStateCommand}"
                Text="{x:Static strings:AppResources.Composants_ChangerEtat}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
