<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CalendAgro.Views.DetailEtapePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CalendAgro.Controls"
    xmlns:strings="clr-namespace:CalendAgro.Resources.Strings"
    xmlns:vm="clr-namespace:CalendAgro.ViewModels"
    x:DataType="vm:DetailEtapeViewModel"
    Title="{Binding PhaseTitre}">

    <Grid RowDefinitions="Auto,*">
        <controls:PageHeader
            Grid.Row="0"
            BackCommand="{Binding RetourCommand}"
            Title="{Binding NomCulture}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="24,16,24,24"
                Spacing="24">

            <controls:StateView
                IsVisible="{Binding IsBusy}"
                Message="{x:Static strings:AppResources.Etape_Chargement}"
                State="Loading" />

            <controls:StateView
                ActionCommand="{Binding RechargerCommand}"
                ActionText="{x:Static strings:AppResources.Composants_Reessayer}"
                IsVisible="{Binding HasError}"
                Message="{x:Static strings:AppResources.Connexion_Erreur}"
                State="Error" />

            <controls:StateView
                ActionCommand="{Binding RetourCommand}"
                ActionText="{x:Static strings:AppResources.Fiche_Retour}"
                IsVisible="{Binding Introuvable}"
                Message="{x:Static strings:AppResources.Etape_Introuvable}"
                State="Empty" />

            <VerticalStackLayout
                Spacing="24"
                IsVisible="{Binding IsContenuVisible}">

                <VerticalStackLayout Spacing="8">
                    <controls:StepBadge
                        HorizontalOptions="Start"
                        Kind="{Binding Kind}"
                        Text="{Binding PhaseTitre}" />
                    <Label
                        Style="{StaticResource Title2}"
                        Text="{Binding Periode}" />
                    <Label
                        Style="{StaticResource BodySmall}"
                        Text="{Binding ZoneSaison}" />
                </VerticalStackLayout>

                <Label
                    Style="{StaticResource Title2}"
                    Text="{x:Static strings:AppResources.Fiche_Conseils}" />

                <VerticalStackLayout
                    Spacing="8"
                    BindableLayout.ItemsSource="{Binding Conseils}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                                <Image
                                    Grid.Column="0"
                                    HeightRequest="20"
                                    Source="check.svg"
                                    VerticalOptions="Start"
                                    WidthRequest="20" />
                                <Label
                                    Grid.Column="1"
                                    Style="{StaticResource Body}"
                                    Text="{Binding .}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label
                    Style="{StaticResource BodySmall}"
                    Text="{x:Static strings:AppResources.Fiche_NoteConseils}" />

            </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
