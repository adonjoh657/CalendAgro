<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CalendAgro.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:CalendAgro.Resources.Strings">
    <ContentView.Content>
        <VerticalStackLayout Spacing="0">
            <Grid
                Padding="16,8"
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="4">
                <ImageButton
                    x:Name="RetourButton"
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    Clicked="OnBackClicked"
                    HeightRequest="48"
                    Padding="12"
                    SemanticProperties.Description="{x:Static strings:AppResources.Composants_Retour}"
                    Source="arrow_left.svg"
                    WidthRequest="48" />
                <Label
                    x:Name="TitreLabel"
                    Grid.Column="1"
                    Padding="4,0,0,0"
                    LineBreakMode="WordWrap"
                    Style="{StaticResource Title1}"
                    VerticalOptions="Center" />
                <ContentView
                    x:Name="ActionsHost"
                    Grid.Column="2"
                    IsVisible="False"
                    VerticalOptions="Center" />
            </Grid>
            <BoxView Color="{StaticResource Border}" HeightRequest="1" />
        </VerticalStackLayout>
    </ContentView.Content>
</ContentView>
