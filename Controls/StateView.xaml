<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CalendAgro.Controls.StateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border Style="{StaticResource Card}">
        <VerticalStackLayout
            Spacing="12"
            HorizontalOptions="Center">
            <VerticalStackLayout
                x:Name="Skeleton"
                Spacing="8">
                <BoxView
                    CornerRadius="8"
                    HeightRequest="16"
                    Color="{StaticResource Border}"
                    WidthRequest="180" />
                <BoxView
                    CornerRadius="8"
                    HeightRequest="16"
                    Color="{StaticResource Border}"
                    WidthRequest="140" />
                <BoxView
                    CornerRadius="8"
                    HeightRequest="16"
                    Color="{StaticResource Border}"
                    WidthRequest="100" />
            </VerticalStackLayout>
            <Label
                x:Name="MessageLabel"
                Style="{StaticResource Body}"
                HorizontalTextAlignment="Center" />
            <Button
                x:Name="ActionButton"
                HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Border>
</ContentView>
