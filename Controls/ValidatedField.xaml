<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CalendAgro.Controls.ValidatedField"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <VerticalStackLayout Spacing="8">
        <Label
            x:Name="LabelLabel"
            Style="{StaticResource Legend}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Border
                Grid.Column="0"
                BackgroundColor="{StaticResource Surface}"
                HeightRequest="56"
                Padding="16,0"
                Stroke="{StaticResource Border}"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="1">
                <Entry
                    x:Name="Input"
                    VerticalOptions="Center" />
            </Border>
            <Button
                x:Name="ToggleButton"
                Grid.Column="1"
                IsVisible="False"
                Style="{StaticResource TextButton}"
                VerticalOptions="Center" />
        </Grid>
        <Label
            x:Name="AideLabel"
            Style="{StaticResource BodySmall}" />
        <HorizontalStackLayout
            x:Name="ErreurRow"
            IsVisible="False"
            Spacing="8">
            <Image
                HeightRequest="20"
                Source="x.svg"
                VerticalOptions="Center"
                WidthRequest="20" />
            <Label
                x:Name="ErreurLabel"
                Style="{StaticResource ErrorText}"
                VerticalOptions="Center" />
        </HorizontalStackLayout>
        <HorizontalStackLayout
            x:Name="SuccesRow"
            IsVisible="False"
            Spacing="8">
            <Image
                HeightRequest="20"
                Source="check.svg"
                VerticalOptions="Center"
                WidthRequest="20" />
            <Label
                x:Name="SuccesLabel"
                Style="{StaticResource SuccessText}"
                VerticalOptions="Center" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>
