        x:Name="Pill"
        Padding="12,4"
        StrokeShape="RoundRectangle 999"
        StrokeThickness="0">
        <Label
            x:Name="TextLabel"
            FontAttributes="Bold"
            FontSize="14"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Border>
</ContentView>
